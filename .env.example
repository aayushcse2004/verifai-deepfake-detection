# VerifAI Platform Configuration
PROJECT_NAME=VerifAI
API_V1_STR=/api/v1
DEBUG=true

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./storage/verifai.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/verifai

# Storage Paths
UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports
FRAME_DIR=./storage/frames

# File Upload Security Limits
MAX_UPLOAD_SIZE_MB=250
ALLOWED_EXTENSIONS=mp4,mov,avi,mkv,wav,mp3,m4a

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# AI/ML Configuration
DEVICE=cpu
ENABLE_GPU=false
WHISPER_MODEL=base
MODEL_CHECKPOINTS_DIR=./models/checkpoints

# Forensic Fusion Weights (must sum to ~1.0)
WEIGHT_FACIAL=0.35
WEIGHT_LIP_SYNC=0.25
WEIGHT_ACTIVE_SPEAKER=0.20
WEIGHT_AUDIO=0.20
